generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum LeadStage {
  FIRST_TOUCH
  SCHEDULED_CALL
  CALL_DONE
  SECOND_TOUCH_KP
  SECOND_CALL_DONE
  KP_SENT
  APPROVED
  PAID
  IN_PROGRESS
  POSTPAY
  SUPPORT
}

enum TaskPriority {
  P0
  P1
  P2
  P3
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum NotificationType {
  TASK_ASSIGNED
  CALL_INVITED
  INCIDENT_ALERT
}

enum DeploymentStatus {
  UNKNOWN
  OK
  DEGRADED
  DOWN
}

enum ReminderThreshold {
  H48
  H24
  H6
  H1
}

model User {
  id                 String  @id @default(cuid())
  name               String
  email              String  @unique
  avatarUrl          String?
  motivationPhotoKey String?
  passwordHash       String
  role               Role    @default(EMPLOYEE)
  isBlocked          Boolean @default(false)

  // Гранулярные права сотрудника (для ADMIN игнорируются — админ может всё).
  editTasksSelf   Boolean @default(true)
  viewAccounting  Boolean @default(true)
  viewChannels    Boolean @default(true)
  editCrm         Boolean @default(false)
  editTasksOthers Boolean @default(false)
  viewSupport     Boolean @default(false)

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())

  telegramChatId          BigInt? @unique
  telegramUsername        String?
  telegramMorningSentDate String?
  telegramEveningSentDate String?
  telegramDueTodaySentDate String?

  leads                  Lead[]
  leadActivity           LeadActivity[]
  tasks                  Task[]                 @relation("TaskAssignee")
  taskComments           TaskComment[]
  taskAttachments        TaskAttachment[]
  transactions           Transaction[]
  projectAccess          ProjectMember[]
  channelSpends          ChannelSpend[]
  channelOutreachBatches ChannelOutreachBatch[]
  calendarEvents         CalendarEvent[]
  attendingEvents        CalendarEvent[]        @relation("EventAttendees")
  taskCompletions        TaskCompletion[]
  notifications          Notification[]

  assignedDeployments SupportedDeployment[] @relation("SupportAssignee")
  resolvedIncidents   SupportIncident[]     @relation("IncidentResolver")
}

model Project {
  id    String @id @default(cuid())
  name  String
  order Int    @default(0)

  tasks   Task[]
  members ProjectMember[]
}

model ProjectMember {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Lead {
  id          String    @id @default(cuid())
  title       String
  company     String?
  description String?
  contactName String?
  contact     String?
  link        String?
  stage       LeadStage @default(SCHEDULED_CALL)
  prepay      Decimal   @default(0) @db.Decimal(12, 2)
  postpay     Decimal   @default(0) @db.Decimal(12, 2)
  monthlySub  Decimal   @default(0) @db.Decimal(12, 2)
  expenses    Decimal   @default(0) @db.Decimal(12, 2)
  notes       String?
  lost        Boolean   @default(false)
  lostReason  String?
  startDate   DateTime  @default(now())
  order       Int       @default(0)
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  channelId String?
  channel   TrafficChannel? @relation(fields: [channelId], references: [id])

  // Только для канала "Партнёрство" — кто из партнёров привёл этого лида,
  // для расчёта комиссии (см. Partner).
  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id])

  activity            LeadActivity[]
  transactions        Transaction[]
  scoutContact        ScoutAgentContact?
  instagramContact    InstagramContact?
  b2bEmailContact     B2bEmailContact?
  supportedDeployment SupportedDeployment?

  @@index([stage])
  @@index([channelId])
  @@index([partnerId])
}

enum PartnerCommissionType {
  PERCENT // commissionValue — проценты от суммы сделки (prepay+postpay), 0-100
  FIXED // commissionValue — фиксированная сумма за каждого оплатившего лида
}

// Партнёр с персональной реферальной ссылкой (см. /r/[code]) — комиссия
// настраивается индивидуально на каждого партнёра при создании, не общим
// правилом на всех. Ссылка — публичный редирект-роут без авторизации
// (партнёр не пользователь CRM), считает переходы и пробрасывает дальше.
model Partner {
  id              String                @id @default(cuid())
  name            String
  commissionType  PartnerCommissionType @default(PERCENT)
  commissionValue Decimal               @db.Decimal(10, 2)
  referralCode    String                @unique
  destinationUrl  String                @default("https://t.me/autogentgroup")
  clickCount      Int                   @default(0)
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())

  leads Lead[]

  @@index([referralCode])
}

// MANUAL — обычные каналы (реклама и т.п.), заводятся и ведутся руками,
// без внешнего агента. Остальные значения — канал обслуживается внешним
// агентом, который пушит данные через /api/integrations/*.
enum TrafficChannelType {
  MANUAL
  SCOUT_TELEGRAM
  INSTAGRAM
  B2B_EMAIL
  TG_AUTOCOMMENT
}

model TrafficChannel {
  id        String             @id @default(cuid())
  name      String
  type      TrafficChannelType @default(MANUAL)
  isActive  Boolean            @default(true)
  order     Int                @default(0)
  createdAt DateTime           @default(now())

  leads                   Lead[]
  spends                  ChannelSpend[]
  metricSnapshots         ScoutAgentMetricSnapshot[]
  scoutContacts           ScoutAgentContact[]
  instagramContacts       InstagramContact[]
  instagramSnapshots      InstagramMetricSnapshot[]
  b2bEmailContacts        B2bEmailContact[]
  b2bEmailSnapshots       B2bEmailMetricSnapshot[]
  knowledgeBase           AgentKnowledgeBase?
  kbMessages              AgentKbMessage[]
  knowledgeCards          AgentKnowledgeCard[]
  instagramSearchProfiles InstagramSearchProfile[]
  instagramScrapeJobs     InstagramScrapeJob[]
  b2bEmailSearchJobs      B2bEmailSearchJob[]
  tgCommentDrafts         TgCommentDraft[]
  tgCommentSnapshots      TgCommentMetricSnapshot[]
  outreachBatches         ChannelOutreachBatch[]
}

// Единая база знаний/правил на канал, редактируемая через чат в разделе
// «Управление» (см. AgentManagementPanel) — LLM читает её как контекст и
// может переписать через tool-call update_knowledge_base. Внешний агент
// (Python) забирает актуальный content через GET .../knowledge-base —
// именно агент инициирует запрос, не CRM, т.к. у агента нет публичного
// адреса (тот же принцип push/pull, что и везде в этой интеграции).
model AgentKnowledgeBase {
  channelId String         @id
  channel   TrafficChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  content   String         @default("") @db.Text
  updatedAt DateTime       @updatedAt
}

// Одна тема базы знаний с датой последнего обсуждения — заменяет плоский
// текст структурированными карточками, обновляемыми по одной за раз
// (tool-call save_knowledge_card), а не полной перезаписью всего файла.
// AgentKnowledgeBase.content остаётся и пересобирается из карточек
// автоматически — внешние агенты (Python) как читали один текстовый content
// через GET .../knowledge-base, так и продолжают, ничего не меняя у себя.
model AgentKnowledgeCard {
  id          String         @id @default(cuid())
  channelId   String
  channel     TrafficChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  topic       String
  content     String         @db.Text
  discussedAt DateTime       @default(now())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([channelId, topic])
  @@index([channelId, discussedAt])
}

model AgentKbMessage {
  id        String         @id @default(cuid())
  channelId String
  channel   TrafficChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  role      String
  content   String         @db.Text
  createdAt DateTime       @default(now())

  @@index([channelId, createdAt])
}

enum ScoutContactStatus {
  WRITTEN
  REPLIED
  CALL_SCHEDULED
  LEAD_CREATED
  DECLINED
}

// Один человек, которому написал скаут-агент — с диалогом и статусом продвижения.
// Апсертится агентом по (channelId, externalId), т.к. агент — источник истины
// для переписки, а не CRM.
model ScoutAgentContact {
  id               String             @id @default(cuid())
  channelId        String
  channel          TrafficChannel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  externalId       String
  name             String?
  telegramUsername String?
  sourceChatName   String?
  triggerMessage   String?
  triggerReason    String?
  outreachAccount  String?
  dialogue         Json?
  status           ScoutContactStatus @default(WRITTEN)
  leadId           String?            @unique
  lead             Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contactedAt      DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([channelId, externalId])
  @@index([channelId, contactedAt])
  @@index([status])
}

// Снимки метрик от скаут-агента (Telethon-юзербот) — приходят push'ем, т.к. агент
// крутится локально без публичного адреса и сам достучаться до него нельзя (pull не
// работает). Payload намеренно нетипизированный JSON: набор полей на стороне агента
// ещё не стабилен, поэтому здесь не заводим Prisma-модель под каждую метрику отдельно.
model ScoutAgentMetricSnapshot {
  id        String         @id @default(cuid())
  channelId String
  channel   TrafficChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  payload   Json
  createdAt DateTime       @default(now())

  @@index([channelId, createdAt])
}

enum InstagramContactStatus {
  FOUND
  CONTACTED
  LEAD_CREATED
  DECLINED
}

// Спарсенный Instagram-аккаунт — база собирается агентом автоматически,
// но пишут людям вручную сотрудники (см. AGENTS.md по этому проекту —
// массовый автообзвон в Instagram сознательно не делаем). Статус двигает
// сотрудник в CRM, не агент.
model InstagramContact {
  id           String                 @id @default(cuid())
  channelId    String
  channel      TrafficChannel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  externalId   String
  username     String
  fullName     String?
  bio          String?
  category     String?
  followers    Int?
  contactInfo  String?
  sourceTag    String?
  draftMessage String?
  status       InstagramContactStatus @default(FOUND)
  leadId       String?                @unique
  lead         Lead?                  @relation(fields: [leadId], references: [id], onDelete: SetNull)
  foundAt      DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([channelId, externalId])
  @@index([channelId, foundAt])
  @@index([status])
}

// Сохранённый профиль поиска ("опиши своего лида") — заполняется через диалог
// в CRM (5 вопросов), даёт повторно запускать парсинг по тем же критериям
// без нового интервью.
model InstagramSearchProfile {
  id        String         @id @default(cuid())
  channelId String
  channel   TrafficChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  name      String
  criteria  Json
  createdAt DateTime       @default(now())

  jobs InstagramScrapeJob[]

  @@index([channelId])
}

enum InstagramJobStatus {
  PENDING
  IN_PROGRESS
  DONE
  FAILED
}

// Задание на парсинг — CRM инициирует (кнопка «Спарсить N»), но у внешнего
// Instagram-сервиса нет публичного адреса, поэтому он сам забирает задания
// через GET .../jobs?status=pending (тот же pull-принцип, что у базы знаний
// скаута) и закрывает через POST .../jobs/:id/complete.
model InstagramScrapeJob {
  id              String                 @id @default(cuid())
  channelId       String
  channel         TrafficChannel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  searchProfileId String
  searchProfile   InstagramSearchProfile @relation(fields: [searchProfileId], references: [id], onDelete: Cascade)
  requestedCount  Int
  status          InstagramJobStatus     @default(PENDING)
  foundCount      Int                    @default(0)
  errorMessage    String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([channelId, status])
}

// Снимки метрик от Instagram-парсера — сколько аккаунтов просканировано/найдено
// за период. Payload свободный JSON, тот же принцип, что у ScoutAgentMetricSnapshot.
model InstagramMetricSnapshot {
  id        String         @id @default(cuid())
  channelId String
  channel   TrafficChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  payload   Json
  createdAt DateTime       @default(now())

  @@index([channelId, createdAt])
}

enum B2bEmailContactStatus {
  WRITTEN // legacy-значение, новые записи в него не пишутся — см. FOUND/SENT
  FOUND
  SENT
  REPLIED
  CALL_SCHEDULED
  LEAD_CREATED
  DECLINED
}

// Компания, найденная агентом парсинга — черновик письма (draftMessage) агент
// пишет сам, но НЕ отправляет: по решению после инцидента с автообзвоном в
// других каналах отправка требует ручного одобрения сотрудником в CRM
// (см. lib/actions/b2bEmailSend.ts). FOUND — распарсили и составили черновик,
// SENT — сотрудник одобрил и письмо реально ушло через SMTP.
model B2bEmailContact {
  id             String                @id @default(cuid())
  channelId      String
  channel        TrafficChannel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  externalId     String
  companyName    String?
  website        String?
  contactEmail   String?
  triggerReason  String?
  draftMessage   String?               @db.Text
  dialogue       Json?
  status         B2bEmailContactStatus @default(FOUND)
  followUpCount  Int                   @default(0)
  nextFollowUpAt DateTime?
  sentAt         DateTime?
  sentById       String?
  leadId         String?               @unique
  lead           Lead?                 @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contactedAt    DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([channelId, externalId])
  @@index([channelId, contactedAt])
  @@index([status])
}

enum B2bEmailJobStatus {
  PENDING
  IN_PROGRESS
  DONE
  FAILED
}

// Задание на поиск компаний — CRM инициирует (кнопка «Спарсить N»), но, в
// отличие от Instagram, отдельного профиля поиска здесь нет: критерии агент
// берёт из общей базы знаний канала (AgentKnowledgeCard) через тот же
// GET .../knowledge-base, что уже читает и генерирует черновики писем.
model B2bEmailSearchJob {
  id             String            @id @default(cuid())
  channelId      String
  channel        TrafficChannel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  requestedCount Int
  status         B2bEmailJobStatus @default(PENDING)
  foundCount     Int               @default(0)
  errorMessage   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([channelId, status])
}

model B2bEmailMetricSnapshot {
  id        String         @id @default(cuid())
  channelId String
  channel   TrafficChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  payload   Json
  createdAt DateTime       @default(now())

  @@index([channelId, createdAt])
}

enum TgCommentDraftStatus {
  PENDING // черновик от бота, ждёт решения сотрудника
  APPROVED // сотрудник одобрил (возможно отредактировал текст) — бот заберёт и отправит
  IN_PROGRESS // "claim on read" — бот забрал APPROVED-черновик, отправка в процессе
  SENT // бот реально опубликовал комментарий
  SKIPPED // сотрудник отклонил
  FAILED // бот попытался отправить и словил ошибку (см. errorMessage)
}

// Черновик комментария под конкретный пост в целевом Telegram-канале.
// Namespaced по (channelId, externalId), где externalId — детерминированный
// id поста ("<юзернейм_канала>:<message_id>"), чтобы повторный обход того же
// поста ботом не плодил дубликаты. Публикация — ТОЛЬКО после ручного
// approve: автокомментинг детектится Telegram агрессивнее, чем чтение
// (см. docs/pipeline/decisions.md), поэтому полного автопостинга нет.
model TgCommentDraft {
  id                    String               @id @default(cuid())
  channelId             String
  channel               TrafficChannel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  externalId            String
  targetChannelUsername String
  postLink              String
  postExcerpt           String?              @db.Text
  draftComment          String               @db.Text
  status                TgCommentDraftStatus @default(PENDING)
  errorMessage          String?
  sentAt                DateTime?
  sentById              String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@unique([channelId, externalId])
  @@index([channelId, status])
  @@index([channelId, createdAt])
}

model TgCommentMetricSnapshot {
  id        String         @id @default(cuid())
  channelId String
  channel   TrafficChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  payload   Json
  createdAt DateTime       @default(now())

  @@index([channelId, createdAt])
}

model ChannelSpend {
  id          String         @id @default(cuid())
  channelId   String
  channel     TrafficChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  amount      Decimal        @db.Decimal(12, 2)
  date        DateTime       @default(now())
  note        String?
  createdById String
  createdBy   User           @relation(fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())

  @@index([channelId])
}

// Ручная агрегированная отчётность по каналу без собственного агента —
// сотрудник рассылает сообщения САМ (hh.ru, вручную/через расширение
// Chrome — не автоматизируем отправку), а сюда заносит итоговые цифры за
// период: сколько отправлено, сколько ответили положительно. Не привязано
// к конкретным лидам по имени — по каждому положительному ответу сотрудник
// отдельно заводит лид на этап FIRST_TOUCH через обычную форму "+ лид".
model ChannelOutreachBatch {
  id            String         @id @default(cuid())
  channelId     String
  channel       TrafficChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sentCount     Int
  positiveCount Int
  note          String?
  createdById   String
  createdBy     User           @relation(fields: [createdById], references: [id])
  createdAt     DateTime       @default(now())

  @@index([channelId, createdAt])
}

// Один OAuth-коннект на всю компанию (не на пользователя) — считаем, что
// канал "Ютуб" один общий, не по человеку. id всегда "singleton", строка
// либо есть, либо канал не подключён.
model YoutubeConnection {
  id           String   @id @default("singleton")
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  expiresAt    DateTime
  channelTitle String?
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Снимок статистики видео на момент последней ручной синхронизации —
// upsert по videoId, история не копится, только последнее известное состояние.
model YoutubeVideoStat {
  id           String    @id @default(cuid())
  videoId      String    @unique
  title        String
  thumbnailUrl String?
  publishedAt  DateTime?
  viewCount    Int       @default(0)
  likeCount    Int       @default(0)
  commentCount Int       @default(0)
  fetchedAt    DateTime  @default(now())
}

// Instagram-аккаунт, за которым следим (Амир/Арсений/общий Autogent и
// т.п.) — через Apify (apify/instagram-profile-scraper, тот же актор, что
// уже используется в instagram_scout_service), только публичные метрики:
// нет доступа к бизнес-аккаунту → нет impressions/reach/retention, только
// views/likes/comments с самого поста.
model InstagramReelsAccount {
  id        String   @id @default(cuid())
  label     String // человекочитаемое имя, например "Амир"
  username  String   @unique
  createdAt DateTime @default(now())

  posts InstagramReelsPost[]
}

model InstagramReelsPost {
  id           String                @id @default(cuid())
  accountId    String
  account      InstagramReelsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  shortcode    String
  caption      String?               @db.Text
  postedAt     DateTime?
  viewCount    Int?
  likeCount    Int                   @default(0)
  commentCount Int                   @default(0)
  thumbnailUrl String?
  fetchedAt    DateTime              @default(now())

  @@unique([accountId, shortcode])
  @@index([accountId, viewCount])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  message   String
  createdAt DateTime @default(now())
}

model TaskBoard {
  id      String       @id @default(cuid())
  name    String
  columns TaskColumn[]
}

model TaskColumn {
  id      String    @id @default(cuid())
  boardId String
  board   TaskBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name    String
  order   Int
  tasks   Task[]
}

model Task {
  id                     String       @id @default(cuid())
  columnId               String
  column                 TaskColumn   @relation(fields: [columnId], references: [id], onDelete: Cascade)
  projectId              String?
  project                Project?     @relation(fields: [projectId], references: [id])
  title                  String
  description            String?
  assigneeId             String?
  assignee               User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  priority               TaskPriority @default(P2)
  isBug                  Boolean      @default(false)
  estimateHours          Decimal?     @db.Decimal(6, 1)
  dueDate                DateTime?
  order                  Int          @default(0)
  archived               Boolean      @default(false)
  completedAt            DateTime?
  deadlineReminderSentAt DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  comments    TaskComment[]
  nodes       TaskNode[]
  attachments TaskAttachment[]
  completions TaskCompletion[]
  deadlineReminderLogs TaskDeadlineReminderLog[]

  @@index([projectId])
  @@index([assigneeId])
}

model TaskDeadlineReminderLog {
  id        String            @id @default(cuid())
  taskId    String
  task      Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  threshold ReminderThreshold
  sentAt    DateTime          @default(now())

  @@unique([taskId, threshold])
}

// Отдельный, не зависящий от жизни самой задачи, журнал фактов выполнения.
// Если задачу потом удалят или заархивируют, эта запись остаётся — счётчик
// "выполнено суммарно" не должен теряться. taskId/userId ставятся в NULL
// при удалении задачи/пользователя, а не каскадно удаляются.
model TaskCompletion {
  id          String   @id @default(cuid())
  taskId      String?
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  taskTitle   String
  completedAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
}

model TaskAttachment {
  id           String       @id @default(cuid())
  taskId       String
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  commentId    String?
  comment      TaskComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  size         Int
  storageKey   String
  uploadedById String
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime     @default(now())

  @@index([taskId])
  @@index([commentId])
}

model TaskComment {
  id            String   @id @default(cuid())
  taskId        String
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  text          String
  attachmentUrl String?
  createdAt     DateTime @default(now())

  attachments TaskAttachment[]
}

model TaskNode {
  id        String     @id @default(cuid())
  taskId    String
  task      Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    TaskNode?  @relation("NodeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  TaskNode[] @relation("NodeChildren")
  title     String
  dueDate   DateTime?
  done      Boolean    @default(false)
  x         Float      @default(0)
  y         Float      @default(0)
  createdAt DateTime   @default(now())
}

model Kpi {
  id        String   @id @default(cuid())
  metricKey String   @unique
  target    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Токен привязки Telegram-аккаунта — в БД, а не в памяти процесса: переживает
// рестарт/редеплой приложения между "нажал Подключить" и "написал боту /start".
model TelegramLinkToken {
  token     String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Settings {
  id                    String @id @default("singleton")
  morningSummaryTime    String @default("09:00")
  eveningSummaryTime    String @default("19:00")
  deadlineCheckInterval Int    @default(60)
  timezone              String @default("Europe/Moscow")
}

model TransactionCategory {
  id           String          @id @default(cuid())
  name         String
  type         TransactionType
  isRecurring  Boolean         @default(false)
  transactions Transaction[]
}

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  attendees User[] @relation("EventAttendees")
  reminderLogs EventReminderLog[]

  @@index([startAt])
}

model EventReminderLog {
  id        String            @id @default(cuid())
  eventId   String
  event     CalendarEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  threshold ReminderThreshold
  sentAt    DateTime          @default(now())

  @@unique([eventId, threshold])
}

model Transaction {
  id          String              @id @default(cuid())
  categoryId  String
  category    TransactionCategory @relation(fields: [categoryId], references: [id])
  leadId      String?
  lead        Lead?               @relation(fields: [leadId], references: [id])
  amount      Decimal             @db.Decimal(12, 2)
  type        TransactionType
  description String?
  date        DateTime            @default(now())
  createdById String
  createdBy   User                @relation(fields: [createdById], references: [id])
  createdAt   DateTime            @default(now())
}

// Раздел "Управление Поддержкой" — проект клиента после сдачи (Lead на
// этапе SUPPORT/POSTPAY), за которым числится реально работающий у клиента
// сервис. heartbeatToken — секрет для пути пинга (см. app/api/support/heartbeat/[token]),
// генерируется приложением (не Prisma-дефолтом), проверяется прямым
// поиском по уникальному индексу, как и остальные интеграционные токены в проекте.
model SupportedDeployment {
  id     String @id @default(cuid())
  leadId String @unique
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  serverHost String?
  services   String[]
  // Ручной runbook (например команда рестарта контейнера) — платформа его
  // только показывает, не выполняет: выполнение произвольных команд на
  // серверах клиентов с платформы — отдельная задача с отдельным периметром
  // безопасности (bastion/agent на стороне клиента), сознательно вне MVP.
  runbook    String?

  heartbeatToken        String @unique
  heartbeatEverySeconds Int    @default(300)

  status           DeploymentStatus @default(UNKNOWN)
  lastHeartbeatAt  DateTime?
  lastStatusDetail String?

  assignedToId String?
  assignedTo   User?   @relation("SupportAssignee", fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incidents SupportIncident[]

  @@index([status])
}

model SupportIncident {
  id           String              @id @default(cuid())
  deploymentId String
  deployment   SupportedDeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  severity TaskPriority @default(P1)
  title    String
  detail   String?

  // autoDetected: true — заведён либо приёмом heartbeat со статусом
  // DEGRADED/DOWN, либо детектором "пропали пинги" (check-stale route).
  autoDetected Boolean @default(false)

  detectedAt   DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("IncidentResolver", fields: [resolvedById], references: [id])
  rootCause    String?

  createdAt DateTime @default(now())

  @@index([deploymentId, resolvedAt])
}
